{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenAI": {
    "Model": "gpt-4.1-mini",
    "Endpoint": "https://api.openai.com/v1/responses",
    "TimeoutSeconds": 45
  },
  "Chat": {
    "MaxUserMessageLength": 4000,
    "MaxConversationMessages": 60,
    "ProductCatalogPath": "Infrastructure/ProductCatalog/approved-products.json",
    "DefaultJurisdiction": "US",
    "DefaultDistributionChannel": "Retail"
  },
  "AllowedHosts": "*"
}
